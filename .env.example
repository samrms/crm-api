# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Database - driver is selected by DATABASE_URL:
#   sqlite://              in-memory SQLite, zero dependencies (dev/demo; data is
#                          lost on restart, migrations run automatically)
#   postgres://...         PostgreSQL (persistent data, production)
# For local PostgreSQL: docker compose -f docker/docker-compose.yml up -d postgres
DATABASE_URL=sqlite://

# Redis (optional in dev — queue falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=change-me-to-a-real-secret-min-32-chars
SESSION_MAX_AGE_DAYS=30

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

# Storage
STORAGE_DIR=./storage

# CORS
CORS_ORIGIN=http://localhost:5173
