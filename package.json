{
  "name": "crm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint --fix src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run format:check",
    "test:watch": "vitest",
    "prepush": "bun run check && bun run test",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && bun run typecheck",
    "db:migrate:up": "bun src/shared/database/migrate.ts up",
    "db:migrate:down": "bun src/shared/database/migrate.ts down",
    "db:reset": "bun run db:migrate:down && bun run db:migrate:up",
    "seed": "bun src/shared/database/seed.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "argon2": "^0.41.0",
    "fastify": "^5.3.2",
    "ioredis": "^5.6.1",
    "kysely": "^0.27.6",
    "nanoid": "^5.1.5",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.6.0",
    "@types/bun": "^1.2.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  }
}
