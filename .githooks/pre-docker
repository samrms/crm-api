#!/usr/bin/env bash
# Builds the image and boots it: an image can compile and still fail to start
# (unresolved path aliases, missing runtime file), so /health is required.
set -Eeuo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=.githooks/lib.sh
. .githooks/lib.sh

IMAGE="${IMAGE:-crm-api:local}"
NAME="${SMOKE_NAME:-crm-smoke}"
PORT="${SMOKE_PORT:-3000}"

# The build downloads dependencies from the registry, so it can hang for a long
# time on a machine without registry access. Cap it: a gate that times out with
# an error is useful, one that never returns is not.
if command -v timeout > /dev/null 2>&1; then
  timeout "${DOCKER_BUILD_TIMEOUT:-900}" \
    docker build --file docker/Dockerfile --tag "$IMAGE" . || {
    warn "docker build failed or timed out - it needs registry access"
    exit 1
  }
else
  docker build --file docker/Dockerfile --tag "$IMAGE" .
fi

docker rm -f "$NAME" > /dev/null 2>&1 || true
docker run -d --name "$NAME" -p "$PORT:3000" \
  -e DATABASE_URL=sqlite:// \
  -e SESSION_SECRET=ci-smoke-secret-not-for-production \
  "$IMAGE" > /dev/null

i=0
while [ "$i" -lt 30 ]; do
  if curl -sf "http://localhost:$PORT/health" > /dev/null; then
    ok "container is healthy ($IMAGE on port $PORT)"
    docker logs "$NAME"
    docker rm -f "$NAME" > /dev/null
    exit 0
  fi
  i=$((i + 1))
  sleep 1
done

warn "container never became healthy:"
docker logs "$NAME" || true
docker rm -f "$NAME" > /dev/null
exit 1
