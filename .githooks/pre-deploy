#!/usr/bin/env bash
# Pre-deploy gate: proves the tree is safe to ship before a release.
#
#   1. the working tree is clean (the image is built from committed code)
#   2. lint, typecheck, format check
#   3. full test suite
#   4. clean build
#   5. read-only migration report
#
# It never writes to the database. Applying migrations stays with the
# deployer's preDeployCommand (render.yml: bun run db:migrate:up), so this gate
# can be pointed at production without side effects.
#
# Not a git hook - git has no such event. Run it with `bun run pre:deploy`.
# Escape hatch: PREDEPLOY_SKIP=1.
set -Eeuo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=.githooks/lib.sh
. .githooks/lib.sh

if [ "${PREDEPLOY_SKIP:-0}" = "1" ]; then
  warn "pre-deploy skipped (PREDEPLOY_SKIP=1)"
  exit 0
fi

need_cmd bun

if [ -n "$(git status --porcelain)" ]; then
  warn "pre-deploy: working tree is not clean:"
  git status --short >&2
  warn "pre-deploy: commit or stash before deploying"
  exit 1
fi
log "pre-deploy: working tree is clean ($(git rev-parse --short HEAD))"

log "pre-deploy: lint, typecheck, format check"
bun run check

log "pre-deploy: tests"
bun run test

log "pre-deploy: build"
bun run build

# Read-only. Without DATABASE_URL there is nothing to compare against, which is
# not a failure: the deploy applies the pending migrations itself.
if [ -z "${DATABASE_URL:-}" ]; then
  warn "pre-deploy: DATABASE_URL not set - skipped the migration report"
  exit 0
fi

log "pre-deploy: migration report (read-only)"
bun run db:migrate:status
log "pre-deploy: pending migrations are applied by preDeployCommand at deploy time"
