#!/bin/sh
# Pre-push gate: every CI job, run before anything leaves the machine.
#   quality -> lint, typecheck, format check
#   tests   -> full suite
#   build   -> clean compile to dist/
#   image   -> docker build, boot it, require /health
#
# Enable once per clone:  git config core.hooksPath .githooks
set -e

echo "pre-push: lint, typecheck, format check"
bun run check

echo "pre-push: tests"
bun run test

echo "pre-push: build"
bun run build

# The image steps need network and a Docker daemon. Without them the hook
# warns and skips those two steps; CI remains the authority on them.
if ! docker info > /dev/null 2>&1; then
  echo "pre-push: docker unavailable - skipped image build and smoke test"
  exit 0
fi

# The build downloads dependencies from the registry, so it can hang for a
# long time on a machine without registry access. Cap it: a gate that times
# out with an error is useful, one that never returns is not.
if command -v timeout > /dev/null 2>&1; then
  timeout "${DOCKER_BUILD_TIMEOUT:-900}" bun run docker:build || {
    echo "pre-push: docker build failed or timed out - it needs registry access"
    exit 1
  }
else
  bun run docker:build
fi

echo "pre-push: smoke test the image"
sh .githooks/smoke.sh crm-api:local
