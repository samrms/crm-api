#!/usr/bin/env bash
# Pre-push hook: run the same gate CI runs, before anything leaves the machine.
#
# `bun run pre:push` runs .githooks/verify: lint, typecheck, format, tests, the
# clean build, then pre:docker. This is deliberately the exact CI command, so a
# green push implies a green pipeline.
#
# Activated by `git config core.hooksPath .githooks`, which points Git at this
# committed file.
#
# Escape hatch for a WIP push: git push --no-verify (or PREPUSH_SKIP=1).
set -Eeuo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=.githooks/lib.sh
. .githooks/lib.sh

if [ "${PREPUSH_SKIP:-0}" = "1" ]; then
  warn "pre-push skipped (PREPUSH_SKIP=1)"
  exit 0
fi

need_cmd bun
log "pre-push: bun run pre:push (lint, typecheck, format, tests, build, image)"
if bun run pre:push; then
  ok "pre-push passed"
else
  status=$?
  warn "pre-push failed (exit $status). Nothing was pushed."
  warn "fix the failures above, or bypass once with: git push --no-verify"
  exit "$status"
fi
